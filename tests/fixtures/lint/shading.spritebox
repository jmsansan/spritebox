; Shading and scale: one sprite that each check reports, and a ball lit from the
; top left that none does. Written by hand from the rules in src/lint/shading.rs.
palette p
  .  transparent
  k  #1a1c2c
  d  #5d275d
  m  #b13e53
  l  #ef7d57
  w  #ffcd75
  1 #ff0000
  2 #00ff00
  3 #0000ff
  4 #ffff00
  5 #ff00ff
  6 #00ffff
  7 #ffffff
  8 #808080
  9 #ff8000

sprite pillow 14x14 palette=p
  ......kk......
  ...kkkddkkk...
  ..kdddmmdddk..
  .kddmmmmmmddk.
  .kdmmllllmmdk.
  .kdmllwwllmdk.
  kdmmlwwwwlmmdk
  kdmmlwwwwlmmdk
  .kdmllwwllmdk.
  .kdmmllllmmdk.
  .kddmmmmmmddk.
  ..kdddmmdddk..
  ...kkkddkkk...
  ......kk......
sprite lit 14x14 palette=p
  ......kk......
  ...kkkwwkkk...
  ..kwwwwllllk..
  .kwwwwllllmmk.
  .kwwwllllmmmk.
  .kwwllllmmmmk.
  kwwllllmmmmmmk
  kwllllmmmmmmdk
  .klllmmmmmmdk.
  .kllmmmmmmddk.
  .klmmmmmmdddk.
  ..kmmmmmdddk..
  ...kkkmdkkk...
  ......kk......
sprite bands 8x5 palette=p
  dddddddd
  mmmmmmmm
  llllllll
  llllllll
  llllllll
sprite big 8x8 palette=p
  ....kkkk
  ....kkkk
  ..kkmmkk
  ..kkmmkk
  kkmmllkk
  kkmmllkk
  kkkkkkkk
  kkkkkkkk
sprite rainbow 3x3 palette=p
  123
  456
  789
