; A pixel font for a game's text: printable ASCII and the letters and marks of
; Spanish. Rows 0-1 hold accents, capitals are 7 rows, and 2 rows descend below
; the baseline. Export it with
;   spritebox font examples/font.spritebox --out hud.ttf
; and draw it at 11, 22, 33... pixels, where every pixel is whole.
font hud height=11 baseline=9 line_height=13 space=3 covers=ascii,spanish
